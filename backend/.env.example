# Copy this file to backend/.env and fill in your own values. Never commit .env.

# Endpoint of your Azure OpenAI resource, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment names (the names you chose in Foundry, not the model names)
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Set to 1 to run without Azure, using a built-in stand-in (for tests and UI work)
USE_FAKE_LLM=0

# Retrieval settings
TOP_K=4
MIN_SCORE=0.25
